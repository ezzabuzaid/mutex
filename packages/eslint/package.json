{
  "name": "@zukhruf/eslint",
  "version": "0.3.19",
  "description": "ESLint rules and configs shared across workspaces. Every check is its own named rule, so a repo's own config cannot silently erase it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/eslint"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/eslint#readme",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "nx"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./nx": {
      "@zukhruf/source": "./src/nx.ts",
      "types": "./dist/nx.d.ts",
      "import": "./dist/nx.js",
      "default": "./dist/nx.js"
    },
    "./react-native": {
      "@zukhruf/source": "./src/react-native.ts",
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.js",
      "default": "./dist/react-native.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.47.0",
    "globals": "^17.13.0",
    "ignore": "^7.0.12",
    "ts-api-utils": "^2.5.0"
  },
  "peerDependencies": {
    "@eslint/js": "^9.30.0 || ^10.0.0",
    "@nx/devkit": ">=21.0.0",
    "@nx/eslint-plugin": ">=21.0.0",
    "eslint": "^9.30.0 || ^10.0.0",
    "eslint-plugin-es-x": "^9.7.0 || ^10.0.0",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-import-x": "^4.16.0",
    "jsonc-eslint-parser": "^2.4.0 || ^3.0.0",
    "typescript": ">=5.8.0 <6.1.0",
    "typescript-eslint": "^8.47.0"
  },
  "peerDependenciesMeta": {
    "@nx/devkit": {
      "optional": true
    },
    "@nx/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-es-x": {
      "optional": true
    }
  }
}
